# CodeMentor AI - Backend Environment Variables Configuration
# Copy this file to .env and fill in the values.

# Server Configuration
PORT=8000
HOST=0.0.0.0

# AI API Configuration (OpenAI-compatible)
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_nvidia_compatible_api_key
AI_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# Supabase Configuration
# Found in: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Supabase JWT Secret (Required to decode & verify auth tokens on the backend)
# Found in: Supabase Dashboard -> Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
